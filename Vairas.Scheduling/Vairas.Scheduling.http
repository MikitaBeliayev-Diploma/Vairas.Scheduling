# Synthetic templates. Supply real authorized IDs and tokens externally. Keep each operation UUID unchanged on an exact transport retry.
@baseUrl = https://localhost:7300
@userToken = <user JWT>
@workloadToken = <workload JWT>
@schoolId = 602e6ca0-5c90-54e6-b8af-5a1d0cf0c21b
@branchId = de15572a-061c-56da-8a81-f4019cb5b398
@teacherId = 6566bee8-3270-52bf-b94e-f2ccbc87af5d
@enrollmentId = b3292000-c968-5c10-8804-b417dfb3e281
@studentId = 556c6677-99df-5adb-8fb8-6de1638a8e37
@vehicleId = 5f8bde6a-4aba-5342-8a13-58d0abe5f043
@groupId = f8db104e-2dde-5851-9959-37a01701d3fc
@lessonId = af8cccdd-4ed3-5c8b-be7f-d374d6dbf52c
@requestId = a14b9c56-a9d9-5a70-94d9-d684e42bebca
@operationId = 3313c629-664d-5cd8-a6d6-4ef811d90582
@appointmentId = 91a03efa-1c9e-5d1e-a9bc-0460e457428c
@ruleVersionId = 94727711-109d-5886-a0a7-189c92ea9f74
@blockId = b0eea25f-35c7-51f6-acb5-3b5905069979
@actorUserId = 726ebb67-50b3-513c-9d4e-99c785ed58f9
@targetId = 98df1ade-f949-5aab-b042-f6fb6d232e5f
@confirmationId = 703f644d-9e06-538c-900e-025ad1f7a7bd

### Return one consistent physical source revision to the authorized Learning workload.
GET {{baseUrl}}/internal/v1/lessons/{{lessonId}}/training-source?schoolId={{schoolId}}
Authorization: Bearer {{workloadToken}}

### Acquire an immediate durable vehicle booking block.
POST {{baseUrl}}/internal/v1/vehicle-blocks
Authorization: Bearer {{workloadToken}}
Idempotency-Key: 72802cf4-813d-5e48-9876-84dddd80a606
Content-Type: application/json

{
  "schoolId": "{{schoolId}}",
  "operationId": "{{operationId}}",
  "vehicleId": "{{vehicleId}}",
  "reason": "Maintenance",
  "conflictPolicy": "RejectIfFutureBookings"
}

### Resolve a lost vehicle block acknowledgement.
GET {{baseUrl}}/internal/v1/vehicle-blocks/by-operation/{{operationId}}?schoolId={{schoolId}}
Authorization: Bearer {{workloadToken}}

### Release one precisely identified block using a distinct command identity.
POST {{baseUrl}}/internal/v1/vehicle-blocks/{{blockId}}/release
Authorization: Bearer {{workloadToken}}
Idempotency-Key: 49f6fd7a-0731-578c-b21f-3117c86c5e7e
Content-Type: application/json

{
  "schoolId": "{{schoolId}}",
  "operationId": "{{operationId}}",
  "releaseOperationId": "5591a796-dbb5-51b5-a71d-1bfc47230799",
  "reason": "Reactivated"
}

### Freeze eligibility and protect roster additions before School changes become effective.
POST {{baseUrl}}/internal/v1/school-eligibility-operations
Authorization: Bearer {{workloadToken}}
Idempotency-Key: e6febcad-5e2b-5279-891d-b688bb19a4c8
Content-Type: application/json

{
  "schoolId": "{{schoolId}}",
  "operationId": "{{operationId}}",
  "actorUserId": "{{actorUserId}}",
  "beforeRevision": 1,
  "afterRevision": 2,
  "targetKind": "Membership",
  "targetId": "{{targetId}}",
  "effectiveFrom": "2030-01-07T08:00:00Z",
  "reducesEligibility": false,
  "resourceKind": "Student",
  "resourceId": "f08e873f-e1cb-542a-943a-e852c94741fc",
  "rosters": [
    {
      "lessonId": "{{lessonId}}",
      "expectedRevision": 1,
      "membershipRevision": 1,
      "participants": [
        {
          "enrollmentId": "{{enrollmentId}}",
          "studentId": "{{studentId}}"
        }
      ]
    }
  ]
}

### Resolve School coordination by its exact immutable operation identity.
GET {{baseUrl}}/internal/v1/school-eligibility-operations/{{operationId}}?schoolId={{schoolId}}
Authorization: Bearer {{workloadToken}}

### Finalize only after verifying the authoritative School decision.
POST {{baseUrl}}/internal/v1/school-eligibility-operations/{{operationId}}/commit?schoolId={{schoolId}}
Authorization: Bearer {{workloadToken}}
Idempotency-Key: 8d2c7405-36bc-53a9-979f-227df1fbf8c8

### Return only the owning school's future allocations for preparing an exact change.
GET {{baseUrl}}/internal/v1/schools/{{schoolId}}/lesson-impacts?targetKind=Membership&targetId={{targetId}}&from=2030-01-07T08:00:00Z
Authorization: Bearer {{workloadToken}}

### Atomically reserve a practical lesson and all its resources.
POST {{baseUrl}}/api/v1/practical-lessons
Authorization: Bearer {{userToken}}
Idempotency-Key: fbccf1e4-f45b-58fe-b5b2-cf0ea49ec690
Content-Type: application/json

{
  "schoolId": "{{schoolId}}",
  "branchId": "{{branchId}}",
  "teacherId": "{{teacherId}}",
  "category": "B",
  "startsAt": "2030-01-07T08:00:00Z",
  "endsAt": "2030-01-07T08:45:00Z",
  "enrollmentId": "{{enrollmentId}}",
  "studentId": "{{studentId}}",
  "vehicleId": "{{vehicleId}}",
  "groupId": null
}

### US-010 additional practical lesson linked to its enrollment and reason (optional reason: trimmed, at most 500 characters).
POST {{baseUrl}}/api/v1/practical-lessons
Authorization: Bearer {{userToken}}
Idempotency-Key: 7d1f3c52-0b7e-5a51-9f43-1c2a8e6b4d10
Content-Type: application/json

{
  "schoolId": "{{schoolId}}",
  "branchId": "{{branchId}}",
  "teacherId": "{{teacherId}}",
  "category": "B",
  "startsAt": "2030-01-08T08:00:00Z",
  "endsAt": "2030-01-08T08:45:00Z",
  "enrollmentId": "{{enrollmentId}}",
  "studentId": "{{studentId}}",
  "vehicleId": "{{vehicleId}}",
  "groupId": null,
  "reason": "Additional lesson: outstanding city driving requirement"
}

